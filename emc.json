{
    "enhConfig": {
        "enhKey": "BeEvanescent",
        "spawn": "be-evanescent/be-evanescent.js",
        "withAttrs": {
            "base": "be-evanescent",
            "_base": {
                "instanceOf": "Array",
                "mapsTo": "whenDefined"
            }
        }
    },
    "customData": {
        "weakRef": {
            "properties": [
                "enhancedElement"
            ]
        },
        "actions": {
            "inferFromParent": {
                "ifAllOf": [
                    "enhancedElement"
                ],
                "ifNoneOf": [
                    "whenDefined"
                ]
            },
            "onWhenDefined": {
                "ifAllOf": [
                    "whenDefined",
                    "enhancedElement"
                ]
            }
        },
        "compacts": {
            "when_resolved_changes_dispatch": "resolved"
        }
    }
}
