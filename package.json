{
  "name": "be-evanescent",
  "version": "0.0.7",
  "description": "be-evanescent is a web component decorator that removes the element it adorns from the DOM tree when the web component definitions it monitors for become registered.",
  "main": "be-evanescent.js",
  "module": "be-evanescent.js",
  "type": "module",
  "keywords": [
    "web-components",
    "web-component",
    "custom-element",
    "custom-elements",
    "FOUC",
    "transient-style"
  ],
  "scripts": {
    "test": "playwright test",
    "serve": "node ./node_modules/spa-ssi/serve.js",
    "safari": "npx playwright wk http://localhost:8000",
    "update": "ncu -u && npm install"
  },
  "dependencies": {
    "be-enhanced": "0.0.189",
    "be-hive": "0.0.267",
    "mount-observer": "0.0.105",
    "trans-render": "0.0.960"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "spa-ssi": "0.0.23"
  },
  "files": [
    "*.*"
  ],
  "exports": {
    ".": "./be-evanescent.js",
    "./be-evanescent.js": "./be-evanescent.js"
  },
  "types": "./ts-refs/be-evanescent/types.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bahrus/be-evanescent.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bahrus/be-evanescent/issues"
  },
  "homepage": "https://github.com/bahrus/be-evanescent#readme"
}
